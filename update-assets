#!/usr/bin/env bash

set -ueo pipefail

asset_dir="${1:-$(realpath ./assets/assets)}"

fail() {
    echo >&2 $(basename $0): "$@"
    exit 1
}

latest_release() {
    gh release list --repo rstms/$1 --limit 1 --json tagName --jq '.[]|.tagName' 2>/dev/null 
}

installed_version() {
    ($1 --version | awk '{print $3}' || true) 2>/dev/null
}

update_version() {
    local name=$1
    local installed=$(installed_version $name)
    local latest=$(latest_release $name) 
    [ -n "$latest" ] || fail no release found: $name
    #echo ${name}: latest=${latest} installed=${installed}
    if [ "$latest" != "$installed" ]; then
        go install github.com/rstms/${name}@${latest}
    fi
    ${name} --version 
}

install_asset() {
    local src="$(realpath "$1")"
    local dst="$(realpath "$asset_dir/bin/$(basename "$src")")"
    cp -vp "$src" "$dst"
    for file in $(exetool depends "$dst"); do 
        cp -vrp "$file" "$asset_dir/bin/$(basename "$file")"
    done
}

rm -rf "$asset_dir"
mkdir -p "$asset_dir/bin"

update_version exetool
update_version winocr

install_asset "$(command -v winocr.exe)"

tesseract="$(command -v tesseract.exe)"
install_asset "$tesseract"

tessdata="$(dirname $(dirname "$tesseract"))/share/tessdata" 
[ -d "$tessdata" ] || fail "tessdata not found"
rm -rf ${asset_dir}/tessdata
cp -vrp "$tessdata" "$asset_dir"
